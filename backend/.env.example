# mock = deterministic, no API keys, works offline (default)
# live = calls real models (OpenAI or Anthropic)
FACTORY_BACKEND=mock
LLM_PROVIDER=openai

# OpenAI (GPT-4o-mini)
# OPENAI_API_KEY=sk-...

# Anthropic (optional alternative)
# ANTHROPIC_API_KEY=sk-ant-...

MODEL_SMALL=gpt-4o-mini
MODEL_MEDIUM=gpt-4o-mini
MODEL_LARGE=gpt-4o-mini

DATABASE_URL=postgresql://factory:factory@localhost:5432/factory
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Optional Confluence vault — paste API token into CONFLUENCE_API_KEY
# Use wiki root (not /wiki/home), e.g. https://your-org.atlassian.net/wiki
# Prefer classic token: https://id.atlassian.com/manage-profile/security/api-tokens
#   → "Create API token" (no scopes). Site URL auth works.
# Or scoped token: "Create API token with scopes" + Confluence write scopes;
#   app auto-uses https://api.atlassian.com/ex/confluence/{cloudId}/...
# CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
# CONFLUENCE_CLOUD_ID=  # optional; auto-resolved from /_edge/tenant_info
# CONFLUENCE_SPACE_KEY=AMORA
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_API_KEY=

# Optional GitHub push for A12 generated code (Contents API)
# Fine-grained PAT needs Contents: Read and write (and Administration if creating repos)
# Classic PAT needs the `repo` scope.
# GITHUB_TOKEN=ghp_...
# GITHUB_DEFAULT_REPO=your-org/amora-generated
# GH_TOKEN=  # accepted as an alias for GITHUB_TOKEN
